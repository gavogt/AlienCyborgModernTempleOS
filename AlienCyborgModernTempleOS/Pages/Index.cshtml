@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="p-4 p-md-5 rounded-4 border shadow-sm hero-surface mb-4">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <span class="badge text-bg-dark border mb-3">Modern TempleOs</span>

                <h1 class="display-6 fw-semibold mb-2">
                    Alien Cyborg: A Modern TempleOS
                </h1>

                <p class="lead text-secondary mb-4">
                    An automated multi-agent orchestration system to talk to Aliens
                </p>

                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-outline-secondary btn-lg" href="#activity">View Activity</a>
                    <a class="btn btn-outline-secondary btn-lg" href="/Docs">Docs</a>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
            {
                <div class="mt-4 alert alert-dark border">
                    @Model.StatusMessage
                </div>
            }

            <div class="col-lg-5">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent border-bottom">
                        <div class="fw-semibold">Upload a Snapshot ZIP</div>
                        <div class="small text-secondary">ZIP containing any number of SingleFile .html pages, primarily youtube home recommendation oriented</div>
                    </div>

                    <div class="card-body">
                        <form method="post"
                              asp-page-handler="UploadSnapshots"
                              enctype="multipart/form-data"
                              id="uploadForm">

                            <div class="mb-3">
                                <label class="form-label">ZIP file</label>
                                <input class="form-control"
                                       type="file"
                                       name="SnapshotZip"
                                       accept=".zip,application/zip"
                                       required />
                                <div class="form-text text-secondary">
                                    Example: yt_home_01.html ... yt_home_20.html zipped together
                                </div>
                            </div>

                            <button type="submit" class="btn btn-outline-primary btn-lg w-100">
                                Upload and Analyze
                            </button>

                            <div class="mt-3 d-none" id="uploadingState">
                                <button class="btn btn-primary w-100" type="button" disabled>
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    Uploading...
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm" id="activity">
        <div class="card-header bg-transparent">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="fw-semibold">Activity</div>
                    <div class="small text-secondary">Snapshot ingestion + agent run log</div>
                </div>
                <button class="btn btn-sm btn-outline-secondary" type="button">Refresh</button>
            </div>
        </div>
        <div class="card-body text-secondary">
            No events yet.
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('uploadForm').addEventListener('submit', function () {
            document.getElementById('uploadingState').classList.remove('d-none');
        });
    </script>
}