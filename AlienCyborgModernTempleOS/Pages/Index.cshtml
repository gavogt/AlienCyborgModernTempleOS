@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
    Layout = "_Layout";
}


<div class="container py-5">
    <div class="p-4 p-md-5 rounded-4 border shadow-sm hero-surface mb-4">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <span class="badge text-bg-dark border mb-3">Modern TempleOs</span>

                <h1 class="display-6 fw-semibold mb-2">
                    Alien Cyborg: Modern TempleOS
                </h1>

                <p class="lead text-secondary mb-4">
                    An automated multi-agent orchestration system to talk to Aliens
                </p>

                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-outline-secondary btn-lg" href="#activity">View Activity</a>
                    <a class="btn btn-outline-secondary btn-lg" href="/Docs">Docs</a>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent border-bottom">
                        <div class="fw-semibold">Launch a Retrieval Job</div>
                        <div class="small text-secondary">Select a browser engine</div>
                    </div>

                    <div class="card-body">
                        <form method="post" asp-page-handler="Launch" id="launchForm">
                            <div class="btn-group w-100" role="group" aria-label="Browser selection">
                                <button type="submit"
                                    class="btn btn-outline-primary btn-lg"
                                    name="browser"
                                    value="chrome"
                                    data-browser="Chrome">
                                Chrome
                                </button>

                            <button type="submit"
                                class="btn btn-outline-primary btn-lg"
                                name="browser"
                                value="firefox"
                                data-browser="Firefox">
                            Firefox
                            </button>

                            <button type="submit"
                                class="btn btn-outline-primary btn-lg"
                                name="browser"
                                value="edge"
                                        data-browser="Edge">
                                Edge
                                </button>
                            </div>

                            <div class="mt-3 d-none" id="launchingState">
                                <button class="btn btn-primary w-100" type="button" disabled>
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                Launching...
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm" id="activity">
        <div class="card-header bg-transparent">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="fw-semibold">Activity</div>
                    <div class="small text-secondary">Automation events</div>
                </div>
                <button class="btn btn-sm btn-outline-secondary" type="button">Refresh</button>
            </div>
        </div>
        <div class="card-body text-secondary">
            No events yet.
        </div>
    </div>
</div>

